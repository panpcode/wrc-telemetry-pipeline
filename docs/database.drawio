        <mxCell id="samples_r16" value="received_at · timestamptz  (DB arrival)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="samples"><mxGeometry y="384" width="340" height="22" as="geometry" /></mxCell>
        <mxCell id="fk1" value="1 rally → many stages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rallies" target="stages"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fk2" value="1 rally → many crews" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rallies" target="entries"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fk3" value="1 stage → millions of samples" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.65;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages" target="samples"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fk4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages" target="gaps"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="logical" value="car (logical link, no FK:&lt;br&gt;entries is per rally)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#999999;endArrow=none;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.12;" edge="1" parent="1" source="entries" target="samples"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;🔑 part of the primary key · → foreign key&lt;br&gt;&lt;span style=&quot;color:#6c8ebf&quot;&gt;■&lt;/span&gt; reference data: few rows, rarely change&lt;br&gt;&lt;span style=&quot;color:#d79b00&quot;&gt;■&lt;/span&gt; events: a few rows per stage&lt;br&gt;&lt;span style=&quot;color:#82b366&quot;&gt;■&lt;/span&gt; measurements: 50 Hz, millions of rows&lt;br&gt;crow's foot = “many” side of the relationship" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="380" height="130" as="geometry" /></mxCell>
        <mxCell id="volume" value="&lt;b&gt;How big does samples get?&lt;/b&gt;&lt;br&gt;50 samples/s × 4 cars × 15 min ≈ 180,000 rows per stage&lt;br&gt;× 20 stages ≈ 3.6 million per rally&lt;br&gt;× 13 rallies ≈ 47 million per year (live only)&lt;br&gt;&lt;br&gt;That's why only &lt;b&gt;samples&lt;/b&gt; is a hypertable,&lt;br&gt;and why the driver's name is not repeated in it." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="230" width="380" height="140" as="geometry" /></mxCell>
        <mxCell id="keynote" value="&lt;b&gt;Why this primary key on samples?&lt;/b&gt;&lt;br&gt;A sample is “number &lt;i&gt;seq&lt;/i&gt;, of &lt;i&gt;car&lt;/i&gt;, on &lt;i&gt;stage&lt;/i&gt;, from &lt;i&gt;source&lt;/i&gt;”.&lt;br&gt;A QoS 1 duplicate has the same key → ON CONFLICT DO NOTHING drops it.&lt;br&gt;&lt;i&gt;source&lt;/i&gt; is in the key so the same sample can exist as live &lt;b&gt;and&lt;/b&gt; logger.&lt;br&gt;&lt;i&gt;ts&lt;/i&gt; is in the key because TimescaleDB requires the time column in every unique key." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="390" width="380" height="140" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
