              <mxPoint x="700" y="800" />
              <mxPoint x="700" y="490" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- EDGES: service park -->
        <mxCell id="e8" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;fontSize=10;labelBackgroundColor=#d5e8d4;" edge="1" parent="1" source="mqCentral" target="ingester">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="batch insert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;fontSize=10;labelBackgroundColor=#d5e8d4;" edge="1" parent="1" source="ingester" target="tsdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#d5e8d4;" edge="1" parent="1" source="tsdb" target="grafLocal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1;strokeColor=#333333;" edge="1" parent="1" source="grafLocal" target="laptops">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EDGES: service park -> cloud -->
        <mxCell id="e12" value="bridge via Starlink / 4G&lt;br&gt;store-and-forward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mqCentral" target="kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EDGES: cloud -->
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;exitX=0.155;exitY=1;" edge="1" parent="1" source="kafka" target="cIngest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;" edge="1" parent="1" source="kafka" target="cAlerts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;exitX=0.845;exitY=1;" edge="1" parent="1" source="kafka" target="cArchiver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;" edge="1" parent="1" source="cIngest" target="cDb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;dashed=1;" edge="1" parent="1" source="cArchiver" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#fff2cc;" edge="1" parent="1" source="cDb" target="grafCloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1;strokeColor=#333333;" edge="1" parent="1" source="s3" target="analytics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1;strokeColor=#333333;" edge="1" parent="1" source="grafCloud" target="remote">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1;strokeColor=#333333;" edge="1" parent="1" source="analytics" target="remote">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LEGEND -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="840" width="640" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lg1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#1f5fbf;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="40" y="880" as="sourcePoint" />
            <mxPoint x="120" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg1t" value="live data (MQTT, QoS 1)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="870" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#1f5fbf;dashed=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="40" y="910" as="sourcePoint" />
            <mxPoint x="120" y="910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg2t" value="store-and-forward / bulk (can arrive late, in bursts)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="900" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg3" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#666666;dashed=1;dashPattern=1 3;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="40" y="940" as="sourcePoint" />
            <mxPoint x="120" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg3t" value="offline download, after the stage" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="130" y="930" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg4t" value="dashed box = hardware / OS / infrastructure info" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="955" width="400" height="20" as="geometry" />
        </mxCell>

        <!-- CAVEAT -->
        <mxCell id="caveat" value="&lt;b&gt;⚠ Regulations&lt;/b&gt;&lt;br&gt;As far as I know, WRC teams don't get live telemetry from the car during a stage. The data is downloaded from the logger afterwards. Live data during the stage goes to the organiser's safety tracking system (GPS, speed, SOS). So this design fits safety tracking or testing best. Check the FIA sporting regulations.&lt;br&gt;&lt;i&gt;This is a concept, not how any real team does it.&lt;/i&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="840" width="1010" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
