        <mxCell id="e7" value="download at service (USB / Ethernet)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1;strokeColor=#666666;dashed=1;dashPattern=1 3;fontSize=10;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="logger" target="tsdb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
