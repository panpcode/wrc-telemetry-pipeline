        <mxCell id="e6" value="MQTT bridge&lt;br&gt;QoS 1 · TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;fontSize=10;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="net" target="mqCentral">
          <mxGeometry relative="1" as="geometry" />
