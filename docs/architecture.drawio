        <!-- EDGES: car -> network -> service park -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;exitX=1;exitY=0.5;" edge="1" parent="1" source="modem" target="net">
          <mxGeometry relative="1" as="geometry" />
