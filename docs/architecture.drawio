        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#1f5fbf;" edge="1" parent="1" source="mqLocal" target="modem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1;strokeColor=#666666;dashed=1;dashPattern=1 3;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sensors" target="logger">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="28" y="215" />
